# Copy this file to .env and paste the key from your course email.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Models (run `python grade.py --list-models` to see what is available and the prices)
GRADER_MODEL=anthropic/claude-sonnet-5.5
FAST_MODEL=anthropic/claude-haiku-5.5
VISION_MODEL=anthropic/claude-haiku-5.5

# Grading behaviour
GRADING_SAMPLES=3            # independent gradings per question; the median is used
GRADING_TEMPERATURE=0.4
DISAGREEMENT_THRESHOLD=0.2   # sample spread > 20% of max marks -> audit + lower confidence
MARK_STEP=0.5                # smallest mark unit
MAX_WORKERS=4                # questions graded in parallel

# Safety net for your $20 credit: a single run stops once it has spent this much
BUDGET_USD=2.0
